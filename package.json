{
  "name": "palco",
  "version": "0.2.0",
  "description": "Local spatial workspace for AI coding agents: terminals, notes and browser portals on an infinite canvas.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "palco": "dist/cli/palco.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json && chmod +x dist/cli/palco.js",
    "build:web": "vite build",
    "build:helper": "scripts/build-helper.sh",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node --test test/e2e/*.test.mjs"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "croner": "^11.0.1",
    "marked": "^18.3.0",
    "node-pty": "^1.1.0",
    "playwright-core": "^1.65.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^13.0.3",
    "dompurify": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true
  }
}
